# Copy to .env (gitignored) and fill in. Keep .env private.

# Destination database: your local warehouse, marked once with
#   COMMENT ON DATABASE <db> IS 'celine:env=local'
# Prefer a role that owns the synced schemas over a superuser (docs/security.md).
DB_LOCAL=postgresql+psycopg://owner:change-me@127.0.0.1:5432/warehouse

# Pull from a serving source beside dev over WSS. With SYNC_SOURCE_URL set, a run pulls.
SYNC_SOURCE_URL=wss://sync-source.example.org/sync/v1
# The pull CA's certificate: the only CA trusted for the host. Keep it in the gitignored pki/.
SYNC_TLS_CA=./pki/pull-ca.crt
# Your own token, as handed to you.
SYNC_TOKEN=

# Without SYNC_SOURCE_URL, a run reads dev directly instead (dev's database must be in reach):
# DB_DEV=postgresql+psycopg://reader:change-me@example-dev.example.org:5432/warehouse
